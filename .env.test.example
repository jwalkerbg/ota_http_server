OTA_TEST_MYSQL_HOST="localhost"
OTA_TEST_MYSQL_DB="ota_test"
OTA_TEST_MYSQL_USER="ota_user"
OTA_TEST_MYSQL_PASSWORD="<database password>"
# Optional MySQL SSL test settings (default: disabled)
# Supported modes: disabled, prefer, required, verify_ca, verify_full
#OTA_TEST_MYSQL_SSL_MODE="verify_full"
#OTA_TEST_MYSQL_SSL_CA="certsd/ca_cert.pem"
#OTA_TEST_MYSQL_SSL_CERT="certsd/client_cert.pem"
#OTA_TEST_MYSQL_SSL_KEY="certsd/client_key.pem"

OTA_TEST_PG_HOST="localhost"
OTA_TEST_PG_DB="ota_test"
OTA_TEST_PG_USER="ota_user"
OTA_TEST_PG_PASSWORD="<database password>"
# Optional PostgreSQL SSL test settings (default: disabled)
# Supported modes: disabled, prefer, required, verify_ca, verify_full
#OTA_TEST_PG_SSL_MODE="verify_full"
#OTA_TEST_PG_SSL_CA="certsd/ca_cert.pem"
#OTA_TEST_PG_SSL_CERT="certsd/client_cert.pem"
#OTA_TEST_PG_SSL_KEY="certsd/client_key.pem"
